{
  "manifest_version": 3,
  "name": "Anchor",
  "version": "1.0.0",
  "description": "Keeps web video and audio paused until you resume, with media-key support, automatic player detection, and ignored sites.",
  "minimum_chrome_version": "119",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Anchor",
    "default_icon": {
      "16": "icons/16-gray.png",
      "32": "icons/32-gray.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "toggle-pause-lock": {
      "description": "Keep the current tab paused, or resume"
    }
  }
}
